# Server Configuration
SERVER_PORT=8080
SERVER_ENV=development

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_USER=wallet_user
DB_PASSWORD=wallet_pass
DB_NAME=digital_wallet
DB_MAX_CONNECTIONS=25

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication
JWT_SECRET=your-secret-key-here
MOCK_AUTH_ENABLED=true

# Transaction Limits (USD)
DAILY_LIMIT=5000.00
WEEKLY_LIMIT=15000.00

# Fraud Detection
FRAUD_AMOUNT_THRESHOLD=10000.00
FRAUD_VELOCITY_THRESHOLD=5
FRAUD_VELOCITY_WINDOW_MINUTES=10

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# OTP
OTP_VALIDITY_SECONDS=300
MOCK_OTP_SECRET=123456

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
